processor FoundationSubtractiveSynth [[ main ]]
{
    output stream float<2> out;
    input event float param1 [[ name: "Pitch", min: 24.0, max: 96.0, init: 57.0, unit: "st" ]];
    input event float param2 [[ name: "Cutoff", min: 20.0, max: 20000.0,
                                mid: 1000.0, init: 1800.0, unit: "Hz" ]];
    input event float param3 [[ name: "Gate", min: 0.0, max: 1.0, init: 1.0 ]];

    float pitch = 57.0f;
    float cutoffHz = 1800.0f;
    float gate = 1.0f;
    float envelope = 0.0f;
    std::oscillators::PolyblepState oscillator;
    std::filters (float)::tpt::svf::Implementation filter;

    event param1 (float v) { pitch = clamp (v, 24.0f, 96.0f); }
    event param2 (float v) { cutoffHz = clamp (v, 20.0f, 20000.0f); }
    event param3 (float v) { gate = clamp (v, 0.0f, 1.0f); }

    void main()
    {
        filter = std::filters (float)::tpt::svf::create (
            std::filters (float)::tpt::svf::Mode::lowPass,
            processor.frequency, 1800.0, 0.8);

        loop
        {
            float frequencyHz = 440.0f * float (pow (2.0, float64 ((pitch - 69.0f) / 12.0f)));
            oscillator.setFrequency (processor.frequency, float64 (frequencyHz));
            float envSeconds = gate > 0.5f ? 0.01f : 0.15f;
            float coefficient = 1.0f - float (exp (-1.0 / float64 (envSeconds * float (processor.frequency))));
            envelope += coefficient * (gate - envelope);
            float modulatedCutoff = cutoffHz * float (pow (2.0, float64 (envelope * 2.0f)));
            float safeCutoff = clamp (modulatedCutoff, 20.0f, float (processor.frequency) * 0.45f);
            filter.setFrequency (processor.frequency, float64 (safeCutoff), 0.8);
            float sample = filter.process (oscillator.nextSawtooth()) * envelope * 0.2f;
            out <- float<2> (sample, sample);
            advance();
        }
    }
}
